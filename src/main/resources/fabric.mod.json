{
	"schemaVersion": 1,
	"id": "celerant",
	"version": "${version}",
	"name": "Celerant VRM",
	"description": "Loads local VRM avatars through MCglTF and adds Iris-compatible runtime toon shading.",
	"authors": [
		"westernbear"
	],
	"license": "AGPL-3.0-only",
	"icon": "assets/celerant/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.westernbear.celerant.client.CelerantClient"
		]
	},
	"mixins": [
		{
			"config": "celerant.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"mcgltf": "26.2-Fabric-2.3.2.8",
		"iris": "1.11.2+mc26.2",
		"oneconfig": ">=1.1.6"
	}
}
